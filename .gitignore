# =============================================================================
# OptimusDB
# =============================================================================
# Ordered by "how likely to accidentally end up in a commit". Machine-generated
# artifacts and secrets first; nice-to-have exclusions last.
# =============================================================================


# -----------------------------------------------------------------------------
# Secrets and local environment
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
.envrc
*.pem
*.key
*.crt
*.p12
secrets/
credentials.json


# -----------------------------------------------------------------------------
# TPC-H build artifacts (regenerable via load_tpch.sh)
# -----------------------------------------------------------------------------
# tpch-build/ contains the vendored electrum/tpch-dbgen source with its own
# .git directory, a Linux-compiled dbgen binary, and .tbl files up to 700 MB
# each. All can be recreated by running bash load_tpch.sh.
project/backend/scripts/tpch-build/
*.tbl


# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging and build
build/
dist/
wheels/
*.manifest
*.spec

