pnpm-debug.log*
lerna-debug.log*


# -----------------------------------------------------------------------------
# Docker
# -----------------------------------------------------------------------------
# Named volumes live in Docker's own storage, not the repo. But local
# compose overrides and swarm secrets should stay out.
docker-compose.override.yml
docker-compose.override.yaml
.docker/


